# Copie este archivo como .env.local para desarrollo, o defina las variables en Vercel
# (Project Settings > Environment Variables).

# URL publica del backend Spring Boot. Next.js reenvia /api/* a esta URL, asi el
# navegador no necesita CORS y el backend puede estar en http (por ejemplo, el
# balanceador de AWS) aunque el visualizador se publique en https.
BACKEND_URL=http://localhost:8080

# Opcional: si se define, el navegador llama directo a esta URL en lugar de usar
# el reenvio (requiere que el backend permita el origen: PAQRAP_CORS_ORIGENES).
# NEXT_PUBLIC_API_URL=https://paqrap-backend.onrender.com
